      "script_block_id": "7a718c94-8229-4e79-a85e-920c8b77d2b3",
      "script_text": "$ErrorActionPreference = \"Stop\"\n\n$TraceSOCUri = \"https://1.1.1.1/\"\n$TraceSOCIP = \"1.1.1.1\"\n$TraceSOCPort = 443\n\n$client = New-Object System.Net.Sockets.TcpClient\n\ntry {\n    $client.Connect(\n        $TraceSOCIP,\n        $TraceSOCPort\n    )\n\n    if (-not $client.Connected) {\n        throw \"Direct TCP connection was not established.\"\n    }\n\n    Start-Sleep -Milliseconds 750\n}\nfinally {\n    $client.Close()\n}\n\ntry {\n    Invoke-WebRequest `\n        -UseBasicParsing `\n        -Uri $TraceSOCUri `\n        -TimeoutSec 5 `\n        -ErrorAction Stop |\n        Out-Null\n}\ncatch {\n    Write-Output (\n        \"TRACESOC_INVOKE_WEBREQUEST_RESULT=\" +\n        $_.Exception.GetType().FullName\n    )\n}\n\nInvoke-Expression '$global:TraceSOCReferenceResult = 1'\n\nWrite-Output \"TRACESOC_REFERENCE_ACTIVITY_COMPLETE\"",
