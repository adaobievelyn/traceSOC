<Event xmlns='http://schemas.microsoft.com/win/2004/08/events/event'><System><Provider Name='Microsoft-Windows-PowerShell' Guid='{a0c1853b-5c40-4b15-8766-3cf1c58f985a}'/><EventID>4104</EventID><Version>1</Version><Level>5</Level><Task>2</Task><Opcode>15</Opcode><Keywords>0x0</Keywords><TimeCreated SystemTime='2026-09-24T12:14:54.3028760Z'/><EventRecordID>4363</EventRecordID><Correlation ActivityID='{062c9bc6-4bf0-0000-7ef0-3906f04bdd01}'/><Execution ProcessID='7156' ThreadID='7064'/><Channel>Microsoft-Windows-PowerShell/Operational</Channel><Computer>SensationalEve</Computer><Security UserID='S-1-5-21-2367207782-2933974256-153965027-1001'/></System><EventData><Data Name='MessageNumber'>1</Data><Data Name='MessageTotal'>1</Data><Data Name='ScriptBlockText'>$ErrorActionPreference = "Stop"

$TraceSOCUri = "https://1.1.1.1/"
$TraceSOCIP = "1.1.1.1"
$TraceSOCPort = 443

$client = New-Object System.Net.Sockets.TcpClient

try {
    $client.Connect(
        $TraceSOCIP,
        $TraceSOCPort
    )

    if (-not $client.Connected) {
        throw "Direct TCP connection was not established."
    }

    Start-Sleep -Milliseconds 750
}
finally {
    $client.Close()
}

try {
    Invoke-WebRequest `
        -UseBasicParsing `
        -Uri $TraceSOCUri `
        -TimeoutSec 5 `
        -ErrorAction Stop |
        Out-Null
}
catch {
    Write-Output (
        "TRACESOC_INVOKE_WEBREQUEST_RESULT=" +
        $_.Exception.GetType().FullName
    )
}

Invoke-Expression '$global:TraceSOCReferenceResult = 1'

